# Controller/source VM configuration. Root-owned, mode 0600.
SOURCE="/mnt/nfs_source"
DEST_HOST="192.168.1.20"
DEST_USER="nfs3-migrate"
DEST_PATH="/mnt/nfs_destination"
SSH_PORT="22"
SSH_KEY="/root/.ssh/nfs_migration_ed25519"
SSH_CONNECT_TIMEOUT="30"
SSH_CIPHER=""                    # Leave blank initially; benchmark before pinning a cipher.
WORKERS="12"
MAX_WORKERS="24"
FPSYNC_MAX_FILES="2000"          # Maximum file entries per fpsync partition
FPSYNC_MAX_BYTES="2g"            # Maximum bytes per fpsync partition
FPSYNC_TMPDIR="/var/lib/nfs3-migrate/fpsync"
FPSYNC_SHARED_DIR="/var/lib/nfs3-migrate/fpsync" # Local jobs; destination need not share this path.
RETRY_MAX="5"
RETRY_BASE_SECONDS="10"
BWLIMIT=""                       # Example: 900M; blank = unlimited.
PARTIAL_DIR=".nfs3-migrate-partial"
STATE_DIR="/var/lib/nfs3-migrate"
LOG_DIR="/var/log/nfs3-migrate"
DB="/var/lib/nfs3-migrate/migration.sqlite"
EXCLUDE_FILE="/etc/nfs3-migrate/excludes.txt"
RSYNC_TIMEOUT="900"

PRESERVE_XATTRS="0"               # Keep 0 unless a user-xattr round-trip succeeds on both NFSv3 filesystems.
SOURCE_QUIESCED="0"              # Set to 1 only for final-sync after writers are stopped/snapshot is mounted.
